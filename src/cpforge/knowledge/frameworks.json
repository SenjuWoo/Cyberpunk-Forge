{
  "schema": 1,
  "note": "Detection markers are paths relative to the game root. 'version_from' is a PE file read for its version resource. Repos are where to check the current release; the forge never downloads them.",
  "frameworks": [
    {"id": "red4ext", "name": "RED4ext", "role": "native plugin loader (C++)", "repo": "https://github.com/WopsS/RED4ext",
     "markers": ["red4ext/RED4ext.dll"], "version_from": "red4ext/RED4ext.dll",
     "logs": ["red4ext/logs/*.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/2380"},
    {"id": "redscript", "name": "redscript", "role": "script compiler for r6/scripts/*.reds", "repo": "https://github.com/jac3km4/redscript",
     "markers": ["engine/tools/scc.exe"], "version_from": null,
     "logs": ["r6/logs/redscript_rCURRENT.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/1511"},
    {"id": "cet", "name": "Cyber Engine Tweaks", "role": "Lua scripting, console, ImGui overlay", "repo": "https://github.com/maximegmd/CyberEngineTweaks",
     "markers": ["bin/x64/plugins/cyber_engine_tweaks.asi"], "version_from": "bin/x64/plugins/cyber_engine_tweaks.asi",
     "logs": ["bin/x64/plugins/cyber_engine_tweaks/cyber_engine_tweaks.log", "bin/x64/plugins/cyber_engine_tweaks/scripting.log", "bin/x64/plugins/cyber_engine_tweaks/mods/*/*.log"],
     "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/107"},
    {"id": "archivexl", "name": "ArchiveXL", "role": "loads new resources, factories, localization, appearances", "repo": "https://github.com/psiberx/cp2077-archive-xl",
     "markers": ["red4ext/plugins/ArchiveXL/ArchiveXL.dll"], "version_from": "red4ext/plugins/ArchiveXL/ArchiveXL.dll",
     "logs": ["red4ext/plugins/ArchiveXL/ArchiveXL-*.log", "red4ext/plugins/ArchiveXL/ArchiveXL.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/4198"},
    {"id": "tweakxl", "name": "TweakXL", "role": "TweakDB edits from r6/tweaks (.yaml / .tweak)", "repo": "https://github.com/psiberx/cp2077-tweak-xl",
     "markers": ["red4ext/plugins/TweakXL/TweakXL.dll"], "version_from": "red4ext/plugins/TweakXL/TweakXL.dll",
     "logs": ["red4ext/plugins/TweakXL/TweakXL-*.log", "red4ext/plugins/TweakXL/TweakXL.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/4197"},
    {"id": "codeware", "name": "Codeware", "role": "redscript library: callbacks, entities, UI, reflection", "repo": "https://github.com/psiberx/cp2077-codeware",
     "markers": ["red4ext/plugins/Codeware/Codeware.dll"], "version_from": "red4ext/plugins/Codeware/Codeware.dll",
     "logs": ["red4ext/plugins/Codeware/Codeware-*.log", "red4ext/plugins/Codeware/Codeware.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/7780"},
    {"id": "mod_settings", "name": "Mod Settings", "role": "in-game settings menu from redscript @runtimeProperty", "repo": "https://github.com/jackhumbert/mod_settings",
     "markers": ["red4ext/plugins/mod_settings/mod_settings.dll"], "version_from": "red4ext/plugins/mod_settings/mod_settings.dll",
     "logs": ["red4ext/logs/mod_settings*.log"], "nexus": null},
    {"id": "input_loader", "name": "Input Loader", "role": "custom input contexts from r6/input/*.xml", "repo": "https://github.com/jackhumbert/cyberpunk2077-input-loader",
     "markers": ["red4ext/plugins/input_loader/input_loader.dll"], "version_from": "red4ext/plugins/input_loader/input_loader.dll",
     "logs": ["red4ext/logs/input_loader.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/4575"},
    {"id": "cybercmd", "name": "cybercmd", "role": "command-line/REDmod compile helper used by Mod Settings on REDmod setups", "repo": "https://github.com/jac3km4/cybercmd",
     "markers": ["bin/x64/plugins/cybercmd.asi"], "version_from": "bin/x64/plugins/cybercmd.asi",
     "logs": ["r6/logs/cybercmd_rCURRENT.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/5176"},
    {"id": "audioware", "name": "Audioware", "role": "custom audio from r6/audioware/<Mod>/*.yaml", "repo": null,
     "markers": ["red4ext/plugins/audioware/audioware.dll"], "version_from": "red4ext/plugins/audioware/audioware.dll",
     "logs": ["red4ext/logs/audioware*.log"], "nexus": "https://www.nexusmods.com/cyberpunk2077/mods/12001"},
    {"id": "redmod", "name": "REDmod (official DLC)", "role": "official mod loader, vanilla script and tweak sources", "repo": null,
     "markers": ["tools/redmod/bin/redMod.exe"], "version_from": null,
     "logs": [], "nexus": null},
    {"id": "reddata", "name": "RedData", "role": "JSON for redscript", "repo": null,
     "markers": ["red4ext/plugins/RedData/RedData.dll"], "version_from": "red4ext/plugins/RedData/RedData.dll", "logs": [], "nexus": null},
    {"id": "redhttpclient", "name": "RedHttpClient", "role": "HTTP client for redscript", "repo": null,
     "markers": ["red4ext/plugins/RedHttpClient/RedHttpClient.dll"], "version_from": "red4ext/plugins/RedHttpClient/RedHttpClient.dll", "logs": ["red4ext/logs/redhttpclient*.log"], "nexus": null},
    {"id": "redfilesystem", "name": "RedFileSystem", "role": "file access for redscript", "repo": null,
     "markers": ["red4ext/plugins/RedFileSystem/RedFileSystem.dll"], "version_from": "red4ext/plugins/RedFileSystem/RedFileSystem.dll", "logs": ["red4ext/logs/redfilesystem*.log"], "nexus": null}
  ],
  "tools": [
    {"id": "wolvenkit", "name": "WolvenKit CLI", "role": "pack/unbundle/uncook/convert game resources (needed for .archive mods)",
     "env": "WOLVENKIT_CLI", "names": ["WolvenKit.CLI.exe", "WolvenKit.CLI", "cp77tools"], "repo": "https://github.com/WolvenKit/WolvenKit"},
    {"id": "luajit", "name": "Lua syntax checker", "role": "syntax check for CET init.lua (luajit, luac5.1 or luac)",
     "env": "CPFORGE_LUA", "names": ["luajit", "luac5.1", "luac", "luac5.4"], "repo": null},
    {"id": "cmake", "name": "CMake", "role": "builds RED4ext plugin projects", "env": null, "names": ["cmake"], "repo": null},
    {"id": "git", "name": "Git", "role": "versioning projects", "env": null, "names": ["git"], "repo": null}
  ]
}
